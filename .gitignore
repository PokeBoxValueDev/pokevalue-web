# .gitignore

# Entorno y variables de entorno
.env
.env.*
!.env.example
*.pem
*.key

# Archivos del sistema operativo y Mac OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Configuración de IA e IDEs
.agents/
.gemini/
.vscode/
.idea/
*.swp
*.swo

# Node.js y dependencias
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cachés, build artifacts y temporales
.cache/
.vite/
.turbo/
.parcel-cache/
.next/
.nuxt/
dist/
build/
out/
coverage/
*.log
*.tmp
*.tsbuildinfo
tmp/
.vercel/
.netlify/