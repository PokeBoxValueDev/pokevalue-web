{
  "name": "pokeboxvalue-web",
  "version": "1.40.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "node scripts/bundle.js",
    "build:html": "node scripts/build-components.js",
    "lint": "node --check src/**/*.js tests/**/*.js sw.js scripts/*.js",
    "test": "node scripts/build-components.js && node scripts/bundle.js && npm run lint && node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:contract": "node --test tests/contract/*.test.js",
    "test:visual": "node --test tests/visual/*.test.js",
    "tag": "node scripts/tag-release.js",
    "prepare": "node scripts/build-components.js && node scripts/setup-hooks.js"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "jsdom": "^24.1.3"
  }
}
