{
  "name": "pokeboxvalue-web",
  "version": "1.26.4",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build:html": "node scripts/build-components.js",
    "test": "node scripts/build-components.js && node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:contract": "node --test tests/contract/*.test.js",
    "test:visual": "node --test tests/visual/*.test.js",
    "lint": "node --check src/**/*.js tests/**/*.js sw.js scripts/*.js",
    "tag": "node scripts/tag-release.js",
    "prepare": "node scripts/build-components.js && node scripts/setup-hooks.js"
  }
}
